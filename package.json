{
  "name": "localtone",
  "version": "1.1.2",
  "private": true,
  "description": "A local-first desktop music player",
  "author": "Localtone",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "lint": "eslint .",
    "format:check": "prettier --check \"*.{cjs,mjs}\" \"src/**/*.{cjs,mjs}\" \"scripts/**/*.{cjs,mjs}\" \"app/**/*.{js,css,html}\" \"build/**/*.{cjs,mjs}\"",
    "format": "prettier --write \"*.{cjs,mjs}\" \"src/**/*.{cjs,mjs}\" \"scripts/**/*.{cjs,mjs}\" \"app/**/*.{js,css,html}\" \"build/**/*.{cjs,mjs}\"",
    "verify": "npm run lint && npm run format:check && npm test",
    "benchmark": "node scripts/benchmark-render.mjs",
    "verify:playback": "electron build/check-playback.cjs",
    "verify:desktop-ui": "electron build/check-desktop-ui.cjs",
    "release:source": "node build/release.mjs source",
    "release:mac": "node build/release.mjs mac",
    "release:win": "node build/release.mjs win",
    "release:linux": "node build/release.mjs linux",
    "dist:dir": "electron-builder --dir --publish never",
    "release:verify-downloads": "node build/verify-downloads.mjs",
    "verify:playlist-icons": "electron build/check-playlist-icons.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.2.3",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.0.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "3.9.9"
  },
  "build": {
    "appId": "com.localtone.player",
    "productName": "Localtone",
    "files": [
      "main.cjs",
      "src/**/*",
      "app/**/*",
      "package.json",
      "build/icon.png",
      "LICENSE",
      "LICENSING.md"
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": [
        "/node_modules/ffmpeg-static/ffmpeg$"
      ]
    },
    "win": {
      "target": [
        "zip",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "artifactName": "Localtone-${version}-${os}-${arch}.${ext}",
    "afterPack": "build/release-hooks.cjs",
    "afterAllArtifactBuild": "build/release-hooks.cjs",
    "portable": {
      "artifactName": "Localtone-${version}-windows-${arch}-portable.exe"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/shn1ggy/localtone.git"
  },
  "homepage": "https://github.com/shn1ggy/localtone",
  "bugs": {
    "url": "https://github.com/shn1ggy/localtone/issues"
  }
}
